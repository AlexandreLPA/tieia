# =============================================================================
# Passarola — Root Environment Variables (Docker Compose)
# =============================================================================
# Copie este arquivo para `.env` na raiz do projeto:
#   cp .env.example .env
#
# O Docker Compose lê este arquivo automaticamente ao subir o `ai-backend` e
# demais microsserviços.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Backend de LLM (Local vs Nuvem via OpenRouter)
# -----------------------------------------------------------------------------
# Opções:
#   - openrouter : Usa modelos grandes na nuvem via OpenRouter (recomendado para
#                  PCs com pouca VRAM ou para máxima qualidade em cortes virais,
#                  análise de ganchos/hooks, chat do Studio e TikTok Compliance)
#   - auto       : Tenta TurboQuant local e faz fallback para Ollama local
#   - ollama     : Força uso de modelos locais via Ollama
#   - turboquant : Força uso do serviço TurboQuant local
# Privacidade: com openrouter, prompts e transcrições saem do seu PC para a nuvem.
# O padrão abaixo (auto) mantém tudo local.
AI_LLM_BACKEND=auto

# Chave da API do OpenRouter (crie em https://openrouter.ai/keys)
# Se ficar em branco, o sistema faz fallback silencioso para o Ollama local.
OPENROUTER_API_KEY=

# Modelo padrão no OpenRouter (pode ser trocado em tempo real pela UI do editor)
# Exemplos gratuitos (o nome termina em ":free"):
#   - nvidia/nemotron-3.5-super-vl:free (texto, imagem e vídeo)
#   - nvidia/nemotron-3-ultra-550b-a55b:free (só texto)
#   - google/gemma-4-31b-it:free (texto, imagem e vídeo)
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# Modelos pagos ficam bloqueados para não gastar créditos. true libera.
OPENROUTER_ALLOW_PAID=false
# Se o modelo falhar (fora do ar, limite de uso), a Passarola tenta outros. Vazio: os próximos
# modelos grátis do catálogo da OpenRouter, que se atualiza sozinho.
OPENROUTER_FALLBACK_MODELS=

# -----------------------------------------------------------------------------
# 2. Modelos Locais (Ollama & Whisper)
# -----------------------------------------------------------------------------
# Modelo padrão do Ollama caso não use OpenRouter (ex: qwen2.5:7b, llama3.2:3b)
OLLAMA_DEFAULT_MODEL=qwen2.5:7b

# Tamanho do modelo Whisper para transcrição local (tiny, base, small, medium, large-v3)
WHISPER_MODEL_SIZE=base

# Orçamento de memória / tier para modelos locais (auto, 4GB, 8GB, 16GB, 32GB)
AI_MEMORY_BUDGET=auto
AI_MODEL_TIER=auto
KV_CACHE_BITS=4

# -----------------------------------------------------------------------------
# 3. Chaves Opcionais de Serviços Externos
# -----------------------------------------------------------------------------
# Sarvam AI (opcional — tradução/TTS)
SARVAM_API_KEY=

# -----------------------------------------------------------------------------
# 4. Credenciais da infraestrutura (troque antes de expor qualquer coisa)
# -----------------------------------------------------------------------------
# As portas do compose ficam presas em 127.0.0.1. Os padrões abaixo servem só
# para uso local. Trocar POSTGRES_PASSWORD depois do primeiro `up` exige recriar
# o volume postgres_data (ou alterar a senha dentro do banco).
POSTGRES_PASSWORD=opencut
SRH_TOKEN=example_token
BETTER_AUTH_SECRET=your-production-secret-key-here
# GPU NVIDIA disponível? cuda. Senão, cpu.
WHISPER_DEVICE=cuda
